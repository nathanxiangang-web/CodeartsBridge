{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex GLM Bridge Worker",
  "type": "object",
  "required": ["id", "transport", "model", "concurrencyLimit", "enabled", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "transport": { "enum": ["local", "ssh", "ssh-shell", "remote-worktree"] },
    "host": { "type": ["string", "null"] },
    "cliPath": { "type": ["string", "null"] },
    "model": { "type": "string", "const": "huaweicloud-maas/GLM-5.2" },
    "concurrencyLimit": { "type": "integer", "minimum": 1, "maximum": 16 },
    "enabled": { "type": "boolean" },
    "role": { "type": "string" },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 100 },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["implement", "review", "test"] },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "transport": { "const": "ssh" } } },
      "then": { "required": ["host", "cliPath"] }
    },
    {
      "if": { "properties": { "transport": { "const": "ssh-shell" } } },
      "then": { "required": ["host"] }
    },
    {
      "if": { "properties": { "transport": { "const": "local" } } },
      "then": { "properties": { "host": { "const": "localhost" } } }
    },
    {
      "if": { "properties": { "transport": { "const": "remote-worktree" } } },
      "then": { "required": ["host"] }
    }
  ],
  "additionalProperties": false
}