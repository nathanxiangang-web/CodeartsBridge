{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex GLM Bridge Project",
  "type": "object",
  "required": ["id", "transport", "projectRoot", "runMode"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "transport": { "enum": ["local", "ssh", "ssh-shell", "remote-worktree"] },
    "projectRoot": { "type": "string", "minLength": 1 },
    "runMode": { "enum": ["auto", "manual", "sandbox"] },
    "model": { "type": "string", "const": "huaweicloud-maas/GLM-5.2" },
    "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "sshHost": { "type": "string" },
    "remoteBridgeRoot": { "type": "string" },
    "remoteCliPath": { "type": ["string", "null"] },
    "remoteWorkspaceRoot": { "type": "string" },
    "allowedWorkerTransports": { "type": "array", "items": { "type": "string" } },
    "workspaceMode": { "enum": ["worktree", "remote-worktree"] }
  },
  "allOf": [
    {
      "if": { "properties": { "transport": { "const": "ssh" } } },
      "then": { "required": ["sshHost", "remoteBridgeRoot"] }
    },
    {
      "if": { "properties": { "transport": { "const": "ssh-shell" } } },
      "then": { "required": ["sshHost"] }
    },
    {
      "if": { "properties": { "transport": { "const": "remote-worktree" } } },
      "then": { "required": ["sshHost", "remoteWorkspaceRoot"] }
    }
  ],
  "additionalProperties": false
}